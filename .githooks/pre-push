#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if [ -x "$root/orchestrator/.venv/Scripts/python.exe" ]; then
    python="$root/orchestrator/.venv/Scripts/python.exe"
elif [ -x "$root/orchestrator/.venv/bin/python" ]; then
    python="$root/orchestrator/.venv/bin/python"
else
    echo 'Repository data guard requires the managed Python environment. Run setup-prereqs.ps1.' >&2
    exit 1
fi
exec "$python" "$root/utilities/check_repository_data.py" --root "$root" --pre-push
